{
  "name": "floatingtodo",
  "version": "0.1.0",
  "private": true,
  "description": "Frameless Electron desktop todo widget.",
  "author": "FloatingTODO",
  "homepage": "https://github.com/whyself/FloatingTODO",
  "repository": {
    "type": "git",
    "url": "https://github.com/whyself/FloatingTODO.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Remove-Item Env:ELECTRON_RUN_AS_NODE -ErrorAction SilentlyContinue; electron .\"",
    "check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1",
    "smoke": "npm run check",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:ELECTRON_BUILDER_CACHE=(Join-Path $PWD '.cache/electron-builder'); electron-builder --win portable\""
  },
  "build": {
    "appId": "io.github.whyself.floatingtodo",
    "productName": "FloatingTODO",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "portable",
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1"
  }
}
